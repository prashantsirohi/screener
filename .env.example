# Copy to .env and adjust. .env is gitignored.

# --- Postgres (source of record) -------------------------------------------
# pg_hba.conf on this machine grants `trust` to 127.0.0.1, so PGPASSWORD is not
# needed locally. Set it anyway if you move to a host that requires auth.
SCREENER_PG_HOST=127.0.0.1
SCREENER_PG_PORT=5432
SCREENER_PG_DATABASE=market_screener
SCREENER_PG_USER=postgres
# SCREENER_PG_PASSWORD=

# --- Paths ------------------------------------------------------------------
# Defaults are <project_root>/data|reports|logs. Override to move artifacts off
# the project tree. Never hardcode repo-local data/... in application code.
# DATA_ROOT=
# REPORTS_ROOT=
# LOGS_ROOT=

# --- Analytics --------------------------------------------------------------
# attach = DuckDB reads Postgres directly via the postgres extension
# parquet = Postgres is materialised to Parquet first (use on hosts that cannot
#           download the DuckDB postgres extension)
SCREENER_ANALYTICS_MODE=attach

# --- Return basis -----------------------------------------------------------
# Which basis the technical layer runs on, for the WHOLE run. Mixing is not an
# option: Yahoo's adjusted close is total return and a bhavcopy series adjusted
# for splits/bonuses is price return, so splicing them steps the series by the
# cumulative dividend yield.
#
#   split_bonus     price return, exchange-sourced  (default)
#   yahoo_adjclose  total return, aggregator-sourced
SCREENER_PRICE_BASIS=split_bonus

# --- Technical gate ---------------------------------------------------------
# Whether the Weinstein stage gates eligibility or only nudges the score.
# Default excludes Stage 3 distribution and Stage 4 decline: neither is ownable
# however good the business is, and without the gate the stage was worth at most
# 5 of 100 points and barely moved selection.
#
#   default   exclude Stage 3 distribution and Stage 4 decline
#   off       no gate; the stage only contributes to the score
#   <list>    explicit |-separated stage names, validated at load
# SCREENER_TECHNICAL_GATE=default
#
# Optional 13-week relative-strength floor in percent, off by default. RS is a
# timing signal and Phase 1 feeds research measured in weeks. Note that 191 of
# 2,051 securities have no computable RS and would be excluded by any floor.
# SCREENER_TECHNICAL_GATE_MIN_RS=0

# --- Scraping ---------------------------------------------------------------
# Optional. screener.in serves complete pages to authenticated sessions; if you
# have an account you may paste your own session cookie here. Do not automate
# login, and check screener.in's terms before enabling.
# SCREENER_SESSION_COOKIE=
